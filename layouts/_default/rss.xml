{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ with site.Title }}{{ . }} :: {{ end }}{{ .Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ with site.Params.description }}— {{ . }}{{ end }}</description>
    <generator>Hugo -- gohugo.io</generator>
    {{ with site.Language.LanguageCode }}<language>{{ . }}</language>{{ end }}
    {{ with site.Copyright }}<copyright>{{ . | plainify }}</copyright>{{ end }}
    {{ with .Date }}<lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{- $pages := .RegularPages }}
    {{- if .IsHome }}{{ $pages = where site.RegularPages "Section" "!=" "" }}{{ end }}
    {{- range first 30 (where $pages "Date" "!=" nil).ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with .Params.author | default site.Params.author }}<author>{{ . }}</author>{{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Description }}{{ . | plainify }}{{ else }}{{ .Summary | plainify }}{{ end }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
